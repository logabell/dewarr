# BOOK_AUDIBLE_REGION=us
# BOOK_NYT_API_KEY=
# BOOK_METADATA_PROXY_URL=http://proxy:3128
# BOOK_CUSTOM_METADATA_URL=http://regional-metadata:8080
# BOOK_CUSTOM_METADATA_TOKEN=
# See docs/METADATA-SOURCES.md for behavior and supported contracts.
