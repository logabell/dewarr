{
  "name": "dewarr-web",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "generate:api": "openapi-typescript ../../docs/openapi.json -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "format:check": "prettier --check src vite.config.ts playwright.config.ts tests",
    "test:unit": "node --test src/randomUUID.test.ts src/pages/namingBuilder.test.ts src/pages/requestStatus.test.ts src/pages/requestFilters.test.ts src/components/releaseNotes.test.ts",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.1",
    "lucide-react": "1.47.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.7",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
