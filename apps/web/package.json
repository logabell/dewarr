{
  "name": "dewarr-web",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "generate:api": "openapi-typescript ../../docs/openapi.json -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "format:check": "prettier --check src vite.config.ts vite.ui.config.ts playwright.config.ts playwright.shared.ts playwright.ui.config.ts tests",
    "test:unit": "python3 ../../scripts/check.py web-unit",
    "test:e2e": "python3 ../../scripts/check.py e2e",
    "test": "python3 ../../scripts/check.py ui",
    "test:ui": "python3 ../../scripts/check.py ui",
    "test:ui:full": "python3 ../../scripts/check.py ui --full",
    "test:e2e:full": "python3 ../../scripts/check.py e2e --full"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.1",
    "lucide-react": "1.47.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.7",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
